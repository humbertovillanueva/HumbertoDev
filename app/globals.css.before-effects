@import "tailwindcss";

:root {
  --bg: #050708;
  --panel: rgba(12, 16, 19, 0.76);
  --panel-solid: #0c1013;
  --line: rgba(255, 255, 255, 0.1);
  --muted: #89939b;
  --text: #f4f7f8;
  --cyan: #4ee7f5;
  --cyan-soft: rgba(78, 231, 245, 0.12);
  --violet: #9f7aea;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--bg);
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

.site-shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 18% 14%, rgba(78, 231, 245, 0.07), transparent 26rem),
    radial-gradient(circle at 78% 24%, rgba(109, 91, 255, 0.07), transparent 30rem),
    var(--bg);
}

.grid-layer {
  pointer-events: none;
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: linear-gradient(to bottom, black 0%, rgba(0,0,0,.7) 42%, transparent 82%);
}

.noise-layer {
  pointer-events: none;
  position: fixed;
  inset: 0;
  z-index: 90;
  opacity: .025;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E");
}

.ambient {
  position: absolute;
  border-radius: 999px;
  filter: blur(130px);
  pointer-events: none;
}

.ambient-one {
  width: 30rem;
  height: 30rem;
  background: rgba(78,231,245,.075);
  top: 10rem;
  left: -13rem;
}

.ambient-two {
  width: 34rem;
  height: 34rem;
  background: rgba(108,86,255,.07);
  top: 27rem;
  right: -18rem;
}

.section {
  position: relative;
  z-index: 2;
  width: min(1240px, calc(100% - 48px));
  margin: 0 auto;
}

.nav-wrap {
  position: fixed;
  z-index: 80;
  top: 18px;
  left: 50%;
  transform: translateX(-50%);
  width: min(1240px, calc(100% - 32px));
  min-height: 62px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 16px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 18px;
  background: rgba(7, 10, 12, .72);
  backdrop-filter: blur(18px);
  box-shadow: 0 18px 70px rgba(0,0,0,.25);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  width: max-content;
  font-weight: 700;
  letter-spacing: -.02em;
}

.brand-mark {
  display: inline-grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 1px solid rgba(78,231,245,.35);
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(78,231,245,.15), rgba(159,122,234,.1));
  color: var(--cyan);
  font: 700 12px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  box-shadow: inset 0 0 20px rgba(78,231,245,.05);
}

.brand-text {
  font-size: 14px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
  color: #aab1b7;
  font-size: 13px;
}

.nav-links a {
  transition: color .2s ease;
}

.nav-links a:hover {
  color: white;
}

.nav-icon {
  justify-self: end;
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: rgba(255,255,255,.03);
}

.nav-icon svg,
.button svg,
.text-link svg,
.project-card-top svg {
  width: 17px;
  height: 17px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.nav-icon svg {
  fill: currentColor;
  stroke: none;
}

.hero {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.08fr .92fr;
  align-items: center;
  gap: 70px;
  padding: 140px 0 86px;
}

.eyebrow,
.section-kicker {
  color: var(--cyan);
  font: 600 11px/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .22em;
  text-transform: uppercase;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 0 5px rgba(78,231,245,.08), 0 0 22px var(--cyan);
  animation: pulse 2.4s ease-in-out infinite;
}

.hero h1 {
  margin: 0;
  max-width: 760px;
  font-size: clamp(62px, 7.2vw, 116px);
  line-height: .88;
  letter-spacing: -.075em;
  font-weight: 760;
}

.hero h1 span,
.about h2 span,
.contact h2 span {
  display: block;
  color: transparent;
  background: linear-gradient(90deg, #5b6268 0%, #a3aab0 46%, #5b6268 100%);
  background-clip: text;
  -webkit-background-clip: text;
}

.hero-lede {
  max-width: 660px;
  margin: 32px 0 0;
  color: #9ba4aa;
  font-size: 18px;
  line-height: 1.75;
}

.hero-actions,
.contact-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 34px;
}

.button {
  min-height: 50px;
  padding: 0 20px;
  border-radius: 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border: 1px solid var(--line);
  font-size: 14px;
  font-weight: 700;
  transition: transform .2s ease, border-color .2s ease, background .2s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  color: #001214;
  border-color: var(--cyan);
  background: var(--cyan);
  box-shadow: 0 16px 40px rgba(78,231,245,.12);
}

.button-ghost {
  background: rgba(255,255,255,.025);
  color: #dfe4e7;
}

.button-ghost:hover {
  border-color: rgba(78,231,245,.35);
  background: rgba(78,231,245,.04);
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-top: 28px;
  color: #687178;
  font: 600 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.hero-meta i {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: #424b50;
}

.hero-visual {
  position: relative;
  width: min(100%, 500px);
  margin-left: auto;
  isolation: isolate;
}

.portrait-card {
  position: relative;
  z-index: 3;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 26px;
  overflow: hidden;
  background: rgba(10,14,17,.82);
  box-shadow: 0 40px 100px rgba(0,0,0,.55), 0 0 80px rgba(78,231,245,.05);
  transform: rotate(1.2deg);
}

.portrait-topbar,
.portrait-footer {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  color: #6f7a81;
  font: 600 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .1em;
}

.portrait-window {
  position: relative;
  margin: 0 8px;
  overflow: hidden;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,.08);
  background: #111;
}

.portrait-window img {
  display: block;
  width: 100%;
  height: auto;
  filter: saturate(.92) contrast(1.03);
}

.portrait-footer b {
  color: var(--cyan);
  font-weight: 700;
}

.scanline {
  pointer-events: none;
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 0%, rgba(78,231,245,.08) 50%, transparent 52%);
  background-size: 100% 160px;
  animation: scan 5.5s linear infinite;
  mix-blend-mode: screen;
}

.orbit {
  position: absolute;
  z-index: 1;
  border: 1px solid rgba(78,231,245,.11);
  border-radius: 50%;
}

.orbit-one {
  inset: -34px;
  animation: spin 24s linear infinite;
}

.orbit-one::after {
  content: "";
  position: absolute;
  width: 8px;
  height: 8px;
  top: 18%;
  right: 7%;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 20px var(--cyan);
}

.orbit-two {
  inset: -68px;
  border-color: rgba(159,122,234,.08);
  animation: spinReverse 34s linear infinite;
}

.floating-chip {
  position: absolute;
  z-index: 6;
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 145px;
  padding: 10px 12px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 14px;
  background: rgba(7,10,12,.82);
  backdrop-filter: blur(14px);
  color: #e8edef;
  font: 700 10px/1.25 ui-monospace, SFMono-Regular, Menlo, monospace;
  box-shadow: 0 18px 50px rgba(0,0,0,.3);
}

.floating-chip small {
  display: block;
  margin-bottom: 4px;
  color: #657078;
  font-size: 8px;
  letter-spacing: .08em;
}

.chip-icon {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 9px;
  background: rgba(78,231,245,.1);
  color: var(--cyan);
}

.chip-one {
  left: -48px;
  bottom: 88px;
  animation: float 4s ease-in-out infinite;
}

.chip-two {
  right: -34px;
  top: 96px;
  animation: float 4.8s ease-in-out infinite reverse;
}

.widget-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--line);
  border-radius: 22px;
  overflow: hidden;
  background: rgba(255,255,255,.018);
  backdrop-filter: blur(10px);
}

.widget {
  min-height: 190px;
  padding: 24px;
  border-right: 1px solid var(--line);
  transition: background .25s ease;
}

.widget:last-child {
  border-right: 0;
}

.widget:hover {
  background: rgba(255,255,255,.025);
}

.widget-label {
  display: block;
  color: #5e686f;
  font: 600 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .12em;
}

.widget strong {
  display: block;
  margin-top: 44px;
  font-size: 20px;
  letter-spacing: -.03em;
}

.widget p {
  margin: 10px 0 0;
  color: #788289;
  font-size: 13px;
  line-height: 1.55;
}

.widget-accent {
  background:
    linear-gradient(145deg, rgba(78,231,245,.07), rgba(159,122,234,.04)),
    rgba(255,255,255,.01);
}

.widget-accent strong {
  color: var(--cyan);
}

.about,
.experience,
.projects,
.command-center,
.contact {
  padding-top: 150px;
}

.about-grid {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: 90px;
  margin-top: 26px;
}

.about h2,
.section-heading h2,
.command-copy h2,
.contact h2 {
  margin: 0;
  font-size: clamp(46px, 5vw, 78px);
  line-height: .98;
  letter-spacing: -.055em;
}

.about-copy {
  padding-top: 8px;
}

.about-copy p,
.command-copy p,
.contact p {
  margin: 0 0 18px;
  color: #8d979d;
  font-size: 17px;
  line-height: 1.75;
}

.skill-marquee {
  margin-top: 72px;
  overflow: hidden;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.skill-track {
  width: max-content;
  display: flex;
  animation: marquee 28s linear infinite;
}

.skill-track span {
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: 70px;
  padding: 0 34px;
  color: #7d878d;
  font: 600 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.skill-track span::after {
  content: "✦";
  position: absolute;
  right: -4px;
  color: rgba(78,231,245,.35);
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 52px;
}

.section-heading h2 {
  margin-top: 18px;
}

.section-number {
  color: #252b2f;
  font: 700 clamp(72px, 10vw, 140px)/.75 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: -.08em;
  user-select: none;
}

.timeline {
  border-top: 1px solid var(--line);
}

.timeline-row {
  display: grid;
  grid-template-columns: 120px 1fr 1fr 36px;
  gap: 24px;
  align-items: center;
  min-height: 150px;
  border-bottom: 1px solid var(--line);
  transition: background .25s ease, padding .25s ease;
}

.timeline-row:hover {
  padding: 0 18px;
  background: rgba(255,255,255,.018);
}

.timeline-date {
  color: var(--cyan);
  font: 600 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .1em;
}

.timeline-main span {
  color: #677178;
  font-size: 12px;
}

.timeline-main h3 {
  margin: 7px 0 0;
  font-size: 22px;
  letter-spacing: -.03em;
}

.timeline-row > p {
  max-width: 420px;
  margin: 0;
  color: #778188;
  font-size: 14px;
  line-height: 1.65;
}

.timeline-arrow {
  justify-self: end;
  color: #59636a;
  font-size: 20px;
}

.search-panel {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 66px;
  margin-bottom: 28px;
  padding: 0 16px 0 20px;
  border: 1px solid var(--line);
  border-radius: 17px;
  background: rgba(255,255,255,.025);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.03);
}

.search-panel > svg {
  flex: 0 0 auto;
  width: 20px;
  height: 20px;
  fill: none;
  stroke: #657078;
  stroke-width: 1.6;
}

.search-panel input {
  flex: 1;
  min-width: 0;
  height: 64px;
  padding: 0 16px;
  border: 0;
  outline: 0;
  background: transparent;
  color: white;
  font-size: 15px;
}

.search-panel input::placeholder {
  color: #596269;
}

.search-panel:focus-within {
  border-color: rgba(78,231,245,.3);
  box-shadow: 0 0 0 4px rgba(78,231,245,.035);
}

.search-panel kbd {
  padding: 6px 8px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 8px;
  background: #0b0f11;
  color: #687178;
  font: 600 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.project-card {
  position: relative;
  min-height: 350px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 26px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 22px;
  background:
    linear-gradient(145deg, rgba(255,255,255,.028), rgba(255,255,255,.008));
  transition: transform .25s ease, border-color .25s ease, background .25s ease;
}

.project-card::after {
  content: "";
  position: absolute;
  width: 240px;
  height: 240px;
  right: -120px;
  bottom: -140px;
  border-radius: 50%;
  background: rgba(78,231,245,.08);
  filter: blur(70px);
  opacity: 0;
  transition: opacity .25s ease;
}

.project-card:hover {
  transform: translateY(-5px);
  border-color: rgba(78,231,245,.22);
  background:
    linear-gradient(145deg, rgba(78,231,245,.035), rgba(255,255,255,.01));
}

.project-card:hover::after {
  opacity: 1;
}

.project-card.featured {
  background:
    radial-gradient(circle at 100% 0%, rgba(78,231,245,.06), transparent 20rem),
    linear-gradient(145deg, rgba(255,255,255,.03), rgba(255,255,255,.008));
}

.project-card-top {
  display: flex;
  justify-content: space-between;
  color: #4f5960;
  font: 600 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
}

.project-type {
  color: var(--cyan);
  font: 600 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.project-card h3 {
  margin: 12px 0 10px;
  font-size: 32px;
  letter-spacing: -.045em;
}

.project-card p {
  max-width: 540px;
  margin: 0;
  color: #7f898f;
  font-size: 14px;
  line-height: 1.65;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 24px;
}

.tag-row span {
  padding: 7px 9px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 8px;
  background: rgba(255,255,255,.02);
  color: #707b81;
  font: 600 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
}

.empty-state {
  grid-column: 1 / -1;
  min-height: 260px;
  display: grid;
  place-items: center;
  align-content: center;
  text-align: center;
  border: 1px dashed rgba(255,255,255,.12);
  border-radius: 22px;
  color: #667078;
}

.empty-state svg {
  width: 34px;
  height: 34px;
  fill: none;
  stroke: var(--cyan);
  stroke-width: 1.2;
}

.empty-state h3 {
  margin: 14px 0 0;
  color: #dce2e5;
}

.empty-state p {
  margin: 5px 0 0;
  font-size: 13px;
}

.command-center {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: 80px;
  align-items: center;
}

.terminal-card {
  border: 1px solid var(--line);
  border-radius: 22px;
  overflow: hidden;
  background: #080b0d;
  box-shadow: 0 34px 100px rgba(0,0,0,.35);
}

.terminal-bar {
  min-height: 52px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 16px;
  border-bottom: 1px solid var(--line);
  color: #59636a;
  font: 600 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
}

.terminal-bar > div {
  display: flex;
  gap: 6px;
}

.terminal-bar i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #30373b;
}

.terminal-bar > span:last-child {
  justify-self: end;
}

.terminal-body {
  min-height: 390px;
  padding: 28px;
  background-image:
    linear-gradient(rgba(255,255,255,.02) 1px, transparent 1px);
  background-size: 100% 28px;
  font: 500 13px/1.7 ui-monospace, SFMono-Regular, Menlo, monospace;
}

.terminal-body p {
  margin: 0 0 4px;
  color: #5f6970;
}

.terminal-body p span {
  color: var(--cyan);
}

.terminal-body strong {
  display: block;
  margin: 0 0 20px 16px;
  color: #c8d0d4;
  font-weight: 500;
}

.terminal-body .terminal-accent {
  color: var(--cyan);
}

.terminal-cursor b {
  display: inline-block;
  color: var(--cyan);
  animation: blink 1s steps(1) infinite;
}

.command-copy {
  max-width: 500px;
}

.command-copy h2 {
  margin: 18px 0 28px;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-top: 8px;
  color: var(--cyan);
  font-size: 14px;
  font-weight: 700;
}

.contact {
  padding-bottom: 150px;
}

.contact-inner {
  position: relative;
  overflow: hidden;
  padding: 70px;
  border: 1px solid rgba(78,231,245,.14);
  border-radius: 28px;
  background:
    radial-gradient(circle at 90% 10%, rgba(78,231,245,.09), transparent 28rem),
    linear-gradient(145deg, rgba(255,255,255,.026), rgba(255,255,255,.008));
}

.contact-inner::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: linear-gradient(to left, black, transparent 70%);
  pointer-events: none;
}

.contact h2 {
  position: relative;
  max-width: 850px;
  margin: 20px 0 26px;
  font-size: clamp(58px, 7vw, 96px);
}

.contact p {
  position: relative;
  max-width: 610px;
}

.contact-actions {
  position: relative;
}

.footer {
  position: relative;
  z-index: 2;
  width: min(1240px, calc(100% - 48px));
  min-height: 100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  border-top: 1px solid var(--line);
  color: #606970;
  font-size: 11px;
}

.footer > div {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #a4adb2;
  font-weight: 700;
}

.footer .brand-mark {
  width: 30px;
  height: 30px;
}

.footer a {
  justify-self: end;
  font: 600 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: .1em;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .55; transform: scale(.8); }
}

@keyframes scan {
  from { background-position: 0 -180px; }
  to { background-position: 0 720px; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes spinReverse {
  to { transform: rotate(-360deg); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-9px); }
}

@keyframes marquee {
  to { transform: translateX(-50%); }
}

@keyframes blink {
  50% { opacity: 0; }
}

@media (max-width: 980px) {
  .nav-wrap {
    grid-template-columns: 1fr auto;
  }

  .nav-links {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    gap: 80px;
    padding-top: 150px;
  }

  .hero-visual {
    margin: 0 auto;
  }

  .widget-strip {
    grid-template-columns: repeat(2, 1fr);
  }

  .widget:nth-child(2) {
    border-right: 0;
  }

  .widget:nth-child(-n+2) {
    border-bottom: 1px solid var(--line);
  }

  .about-grid,
  .command-center {
    grid-template-columns: 1fr;
    gap: 50px;
  }

  .timeline-row {
    grid-template-columns: 90px 1fr 36px;
  }

  .timeline-row > p {
    grid-column: 2 / 4;
    padding-bottom: 28px;
  }

  .project-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .section,
  .footer {
    width: min(100% - 28px, 1240px);
  }

  .nav-wrap {
    width: calc(100% - 20px);
    top: 10px;
    min-height: 56px;
    border-radius: 15px;
  }

  .brand-text {
    display: none;
  }

  .hero {
    min-height: auto;
    padding: 125px 0 70px;
    gap: 62px;
  }

  .hero h1 {
    font-size: clamp(54px, 17vw, 76px);
  }

  .hero-lede {
    font-size: 16px;
  }

  .hero-actions .button {
    flex: 1;
    min-width: 145px;
  }

  .chip-one {
    left: -4px;
    bottom: 58px;
  }

  .chip-two {
    right: -2px;
    top: 72px;
  }

  .floating-chip {
    transform: scale(.9);
  }

  .widget-strip {
    grid-template-columns: 1fr;
  }

  .widget {
    min-height: 160px;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .widget:last-child {
    border-bottom: 0;
  }

  .widget strong {
    margin-top: 28px;
  }

  .about,
  .experience,
  .projects,
  .command-center,
  .contact {
    padding-top: 110px;
  }

  .about-grid {
    gap: 34px;
  }

  .section-heading {
    align-items: start;
  }

  .section-number {
    display: none;
  }

  .timeline-row {
    grid-template-columns: 72px 1fr 20px;
    gap: 12px;
    padding: 24px 0;
  }

  .timeline-row:hover {
    padding: 24px 8px;
  }

  .timeline-main h3 {
    font-size: 18px;
  }

  .timeline-row > p {
    grid-column: 2 / 4;
    padding-bottom: 0;
    font-size: 13px;
  }

  .project-card {
    min-height: 320px;
    padding: 22px;
  }

  .terminal-body {
    min-height: 340px;
    padding: 22px;
    font-size: 12px;
  }

  .contact-inner {
    padding: 42px 24px;
  }

  .footer {
    grid-template-columns: 1fr auto;
    gap: 10px;
  }

  .footer p {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  * {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
  }
}
